@article{Lemons_Firrman_Mahalak_Effect_Sodium_2025,
X_TooBib = {date: 09/2025},
X_TooBib = {year: 2025,  infield_fix_dates },
X_TooBib = {month: 09,  infield_fix_dates },
X_TooBib = {urldate: FixBeKvp s= cmd=date "+%Y-%m-%d" d=2026-03-18 dn=urldate},
X_TooBib = {author: Lemons , Johanna M. S. and Firrman , Jenni and Mahalak , Karley K. and Liu , LinShu and Narrowe , Adrienne B. and Higgins , Stephanie and Moustafa , Ahmed M. and Baudot , Aur\'{e}lien and Deyaert , Stef and den Abbeele , Pieter Van},
abbrvjrnl = {Foods},
abstract = {<jats:p>The food additive sodium benzoate (SB) has been used for decades as an antimicrobial to prevent food spoilage. SB has been deemed to pose no risk to human health when consumed at levels under 5 mg/kg body weight per day; however, when many of the supporting studies were conducted, the importance of the gut microbiome to human health was not yet appreciated. Given SB's known antimicrobial qualities, it is important to assess the effect of this food additive on the human gut microbiome. The ex vivo SIFR\textrm{\small\textregistered} (Systemic Intestinal Fermentation Research) technology was used to test the effect of SB on microbial communities from 24 donors, aged infants to older adults. A dose of 3.5 g/L SB elicited a drop in the Pseudomonadota phylum for multiple age groups but did not alter the alpha or beta diversity within any of these groups. This was accompanied by changes in the functional outputs that included an overall rise in butyrate and a drop in propionate production. This higher butyrate correlates with an increase in the abundance of several known butyrate producers in the presence of SB, although the genetic potential for its production in the community did not change. Overall, despite using a dose ten times higher than the accepted daily intake limit, the effect on the gut microbiome was minimal.</jats:p>},
abstract_as_rcvd = {<jats:p>The food additive sodium benzoate (SB) has been used for decades as an antimicrobial to prevent food spoilage. SB has been deemed to pose no risk to human health when consumed at levels under 5 mg/kg body weight per day; however, when many of the supporting studies were conducted, the importance of the gut microbiome to human health was not yet appreciated. Given SBôs known antimicrobial qualities, it is important to assess the effect of this food additive on the human gut microbiome. The ex vivo SIFR¬Æ (Systemic Intestinal Fermentation Research) technology was used to test the effect of SB on microbial communities from 24 donors, aged infants to older adults. A dose of 3.5 g/L SB elicited a drop in the Pseudomonadota phylum for multiple age groups but did not alter the alpha or beta diversity within any of these groups. This was accompanied by changes in the functional outputs that included an overall rise in butyrate and a drop in propionate production. This higher butyrate correlates with an increase in the abundance of several known butyrate producers in the presence of SB, although the genetic potential for its production in the community did not change. Overall, despite using a dose ten times higher than the accepted daily intake limit, the effect on the gut microbiome was minimal.</jats:p>},
