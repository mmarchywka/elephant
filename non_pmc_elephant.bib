@article{Sang_Philbert_Hartland_Coenzyme_Dependent_Tricarboxylic_2022,
X_TooBib = {date: 06/10/2022},
X_TooBib = {year: 2022,  infield_fix_dates },
X_TooBib = {month: 06,  infield_fix_dates },
