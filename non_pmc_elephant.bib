@article{Dai_Chen_Association_between_dietary_vitamin_2024,
X_TooBib = {date: 2024},
X_TooBib = {year: 2024,  infield_fix_dates },
X_TooBib = {urldate: FixBeKvp s= cmd=date "+%Y-%m-%d" d=2026-03-03 dn=urldate},
X_TooBib = {author: Dai , Heng and Chen , Ziyi},
abstract = {<jats:p>As an anti-inflammatory and antioxidant, vitamin K has the potential to reduce telomere attrition. However, the correlation between dietary vitamin K and telomere length (TL) has not been reported. We aimed to investigate the association between these 2 variables. This study included 3754 participants from the National Health and Nutrition Examination Survey 2001-2002 database. We used multivariate linear regression and restricted cubic splines to assess the relationship between dietary vitamin K intake and TL. Subgroup analyses and interaction tests were utilized to examine the stability of the results. After adjusting for all variables, each unit increase in daily dietary intake of vitamin K lengthened telomeres by 0.22 base pairs (upbeta=0.22, 95% CI: 0.09-0.36, <jats:italic toggle=yes>P</jats:italic>=.001). Individuals with the highest dietary vitamin K intake had significantly longer TL (upbeta=80.27, 95% CI: 20.83-139.71, <jats:italic toggle=yes>P</jats:italic>=.008). Subgroup analyses suggested that this association persisted in populations stratified by gender, age, diabetes, cardiovascular disease (CVD), body mass index and total energy intake (<jats:italic toggle=yes>P</jats:italic> for interaction\&gt;.05). A linear relationship between dietary vitamin K intake and TL was observed in restricted cubic splines (<jats:italic toggle=yes>P</jats:italic> for nonlinear<jats:italic toggle=yes>=</jats:italic>.554). In conclusion, our findings suggest that dietary vitamin K intake is positively associated with TL, providing recent evidence to guide the management of healthy diets.</jats:p>},
abstract_as_rcvd = {<jats:p>As an anti-inflammatory and antioxidant, vitamin K has the potential to reduce telomere attrition. However, the correlation between dietary vitamin K and telomere length (TL) has not been reported. We aimed to investigate the association between these 2 variables. This study included 3754 participants from the National Health and Nutrition Examination Survey 2001‚Äì2002 database. We used multivariate linear regression and restricted cubic splines to assess the relationship between dietary vitamin K intake and TL. Subgroup analyses and interaction tests were utilized to examine the stability of the results. After adjusting for all variables, each unit increase in daily dietary intake of vitamin K lengthened telomeres by 0.22 base pairs (‚ÄÖ=‚ÄÖ0.22, 95% CI: 0.09‚Äì0.36, <jats:italic toggle=yes>P</jats:italic>‚ÄÖ=‚ÄÖ.001). Individuals with the highest dietary vitamin K intake had significantly longer TL (‚ÄÖ=‚ÄÖ80.27, 95% CI: 20.83‚Äì139.71, <jats:italic toggle=yes>P</jats:italic>‚ÄÖ=‚ÄÖ.008). Subgroup analyses suggested that this association persisted in populations stratified by gender, age, diabetes, cardiovascular disease (CVD), body mass index and total energy intake (<jats:italic toggle=yes>P</jats:italic> for interaction‚ÄÖ\&gt;‚ÄÖ.05). A linear relationship between dietary vitamin K intake and TL was observed in restricted cubic splines (<jats:italic toggle=yes>P</jats:italic> for nonlinear<jats:italic toggle=yes>‚ÄÖ=‚ÄÖ</jats:italic>.554). In conclusion, our findings suggest that dietary vitamin K intake is positively associated with TL, providing recent evidence to guide the management of healthy diets.</jats:p>},
