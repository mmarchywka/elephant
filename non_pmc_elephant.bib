% citeurl: http://api.crossref.org/works/doi:10.1079/BJN20051578

@article{Yan_Zhou_Nigdikar_Effect_apolipoprotein_2005,
X_TooBib = {date: 12/2005},
X_TooBib = {year: 2005,  infield_fix_dates },
X_TooBib = {month: 12,  infield_fix_dates },
X_TooBib = {urldate: FixBeKvp s= cmd=date "+%Y-%m-%d" d=2026-01-29 dn=urldate},
X_TooBib = {author: Yan , Liya and Zhou , Bo. and Nigdikar , Shailja and Wang , Xiaohong and Bennett , Janet and Prentice , Ann},
abbrvjrnl = {Br J Nutr},
abstract = {<jats:p>The vitamin K concentration in the circulation and the availability of vitamin K to bone may be affected by factors influencing lipoprotein metabolism, such as apoE genotype. The relationships between markers of vitamin K status, bone mineral content and apoE genotype were studied in healthy older men and women aged 60-83 years, 177 from Shenyang, China, and 132 from Cambridge, UK. Fasting plasma was analysed for vitamin K<jats:sub>1</jats:sub>, triacylglycerol, total osteocalcin, undercarboxylated osteocalcin (ucOC) and apoE genotype. Hip bone mineral content was measured using dual-energy X-ray absorptiometry. Subjects were grouped according to apoE genotype as E2/3, E3/3 and [E3/4+E4/4]. The mean plasma vitamin K<jats:sub>1</jats:sub>concentration of the three genotype groups was significantly higher and the percentage ucOC was lower in the Chinese than in the British subjects (<jats:italic>P</jats:italic>\&lt;0\textperiodcentered01). A higher vitamin K<jats:sub>1</jats:sub>concentration was found in subjects with [E3/4+E4/4] than those with either E2/3 or E3/3 in Cambridge (32\textperiodcentered2 (SE 14\textperiodcentered6) %,<jats:italic>P</jats:italic>=0\textperiodcentered03; 24\textperiodcentered6 (SE 10\textperiodcentered7) %,<jats:italic>P</jats:italic>=0\textperiodcentered02). Similar trends were observed although were not statistically significant in Shenyang (26\textperiodcentered5 (18\textperiodcentered9) %,<jats:italic>P</jats:italic>=0\textperiodcentered16; 23\textperiodcentered1 (13\textperiodcentered0) %,<jats:italic>P</jats:italic>=0\textperiodcentered08). Subjects with [E3/4+E4/4] had a lower percentage ucOC (total osteocalcin adjusted) than did those with either E2/3 or E3/3 in Shenyang (65\textperiodcentered1 (27\textperiodcentered2) %,<jats:italic>P</jats:italic>=0\textperiodcentered02; 49\textperiodcentered6 (19\textperiodcentered9) %,<jats:italic>P</jats:italic>=0\textperiodcentered01 respectively) but not in Cambridge. This study demonstrates that a superior vitamin K status is associated with the apoE4 genotype in healthy older individuals from China and the UK.</jats:p>},
abstract_as_rcvd = {<jats:p>The vitamin K concentration in the circulation and the availability of vitamin K to bone may be affected by factors influencing lipoprotein metabolism, such as apoE genotype. The relationships between markers of vitamin K status, bone mineral content and apoE genotype were studied in healthy older men and women aged 60‚83 years, 177 from Shenyang, China, and 132 from Cambridge, UK. Fasting plasma was analysed for vitamin K<jats:sub>1</jats:sub>, triacylglycerol, total osteocalcin, undercarboxylated osteocalcin (ucOC) and apoE genotype. Hip bone mineral content was measured using dual-energy X-ray absorptiometry. Subjects were grouped according to apoE genotype as E2/3, E3/3 and [E3/4+E4/4]. The mean plasma vitamin K<jats:sub>1</jats:sub>concentration of the three genotype groups was significantly higher and the percentage ucOC was lower in the Chinese than in the British subjects (<jats:italic>P</jats:italic>\&lt;0¬∑01). A higher vitamin K<jats:sub>1</jats:sub>concentration was found in subjects with [E3/4+E4/4] than those with either E2/3 or E3/3 in Cambridge (32¬∑2 (SE 14¬∑6) %,<jats:italic>P</jats:italic>=0¬∑03; 24¬∑6 (SE 10¬∑7) %,<jats:italic>P</jats:italic>=0¬∑02). Similar trends were observed although were not statistically significant in Shenyang (26¬∑5 (18¬∑9) %,<jats:italic>P</jats:italic>=0¬∑16; 23¬∑1 (13¬∑0) %,<jats:italic>P</jats:italic>=0¬∑08). Subjects with [E3/4+E4/4] had a lower percentage ucOC (total osteocalcin adjusted) than did those with either E2/3 or E3/3 in Shenyang (65¬∑1 (27¬∑2) %,<jats:italic>P</jats:italic>=0¬∑02; 49¬∑6 (19¬∑9) %,<jats:italic>P</jats:italic>=0¬∑01 respectively) but not in Cambridge. This study demonstrates that a superior vitamin K status is associated with the apoE4 genotype in healthy older individuals from China and the UK.</jats:p>},
